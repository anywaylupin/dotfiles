// ── workspaces ──
// Centre island. Ten clickable workspace buttons plus the focused window.
// The native hyprland/workspaces module is not used: its built-in
// `activate` sends a hyprlang dispatch string that a Lua-configured
// Hyprland rejects, so clicking it does nothing.
{
  "custom/ws1": {
    "exec": "$HOME/repos/dotfiles/waybar/scripts/ws-state.sh 1 一",
    "return-type": "json",
    "interval": "once",
    "signal": 1,
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
    "tooltip": true
  },
  "custom/ws2": {
    "exec": "$HOME/repos/dotfiles/waybar/scripts/ws-state.sh 2 二",
    "return-type": "json",
    "interval": "once",
    "signal": 1,
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
    "tooltip": true
  },
  "custom/ws3": {
    "exec": "$HOME/repos/dotfiles/waybar/scripts/ws-state.sh 3 三",
    "return-type": "json",
    "interval": "once",
    "signal": 1,
