    "tooltip": true
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip-format": "active submap: {}"
  },
  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 17,
    "max-length": 34,
    "separate-outputs": true,
    "rewrite": {
      "": "",
      "(.*) - Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1",
      "(.*) - Dolphin": "$1"
    }
  }
}
