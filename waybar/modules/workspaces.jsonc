    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
    "tooltip": true
  },
  "custom/ws7": {
    "exec": "$HOME/repos/dotfiles/waybar/scripts/ws-state.sh 7 七",
    "return-type": "json",
