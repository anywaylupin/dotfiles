// ── stats ──
// Left island. Machine readouts.
{
  "cpu": {
    "format": "{usage}%",
    "interval": 5,
    "tooltip": true
  },
  "memory": {
    "format": "{used:0.2f}GB",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G of {total:0.1f}G  ({percentage}%)"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#d97757'><b>{}</b></span>",
        "days": "<span color='#faf9f5'>{}</span>",
        "weekdays": "<span color='#b0aea5'><b>{}</b></span>"
      }
    }
  },
  "custom/date": {
    "exec": "$HOME/repos/dotfiles/waybar/scripts/date-cn.py",
    "return-type": "json",
    "interval": 300,
    "tooltip": true,
    "on-click": "kitty --title calendar -e sh -c 'cal -3; echo; read -r'"
  },
  "temperature": {
    "format": "{temperatureC}°",
    "interval": 10,
    "critical-threshold": 82,
    "tooltip-format": "{temperatureC}°C"
  }
}
